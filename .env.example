# Frontend-only environment variables (no backend secrets belong here)

# Base URL for API requests. Leave empty to use same-origin relative paths
# (works with the Vite dev proxy and a reverse-proxy production setup).
# Set to the deployed backend origin when frontend and backend are on
# separate domains, e.g. https://api.muwakaba.example.com
VITE_API_BASE_URL=

# Analytics (injected into index.html placeholders)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Map feature
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
